{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2aipfs.dev/schemas/1.0/query.schema.json",
  "title": "a2aipfs query payload",
  "type": "object",
  "required": ["question"],
  "additionalProperties": false,
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 32 },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
  }
}
